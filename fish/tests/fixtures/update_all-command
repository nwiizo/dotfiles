#!/bin/sh
# Test double for updater subprocesses and Codex; never runs a real updater.
case "${0##*/}" in
    fish)
        exec "$UPDATE_ALL_TEST_FISH" --no-config "$@"
        ;;
    mktemp)
        exec /usr/bin/mktemp -d "$UPDATE_ALL_TEST_DIR/tmp/run.XXXXXX"
        ;;
    date)
        if [ "${UPDATE_ALL_TEST_TIMEOUT:-0}" = 1 ]; then
            if [ -f "$UPDATE_ALL_TEST_DIR/clock" ]; then
                echo 1000
            else
                touch "$UPDATE_ALL_TEST_DIR/clock"
                echo 0
            fi
        else
            exec /bin/date "$@"
        fi
        ;;
    brew)
        printf '%s\n' "$*" >> "$UPDATE_ALL_TEST_DIR/brew.calls"
        case "$1" in
            info)
                if [ "${UPDATE_ALL_TEST_BREW_INFO:-}" = fail ]; then
                    echo 'formula metadata unavailable' >&2
                    exit 6
                elif [ "${UPDATE_ALL_TEST_BREW_INFO:-}" = malformed ]; then
                    echo 'invalid JSON'
                    exit 0
                elif [ "${UPDATE_ALL_TEST_BREW_UNLINKED:-0}" = 1 ]; then
                    cat <<'JSON'
{"formulae":[
  {"full_name":"typescript","outdated":true,"pinned":false,"keg_only":false,"linked_keg":null},
  {"full_name":"minorole/tap/gpane","outdated":true,"pinned":false,"keg_only":false,"linked_keg":null},
  {"full_name":"linked-tool","outdated":true,"pinned":false,"keg_only":false,"linked_keg":"1.0"},
  {"full_name":"current-tool","outdated":false,"pinned":false,"keg_only":false,"linked_keg":null},
  {"full_name":"pinned-tool","outdated":true,"pinned":true,"keg_only":false,"linked_keg":null},
  {"full_name":"keg-only-tool","outdated":true,"pinned":false,"keg_only":true,"linked_keg":null}
]}
JSON
                else
                    echo '{"formulae":[]}'
                fi
                exit 0
                ;;
            install)
                [ "$*" = 'install --formula --skip-link typescript minorole/tap/gpane' ] || exit 11
                [ "${UPDATE_ALL_TEST_BREW_INSTALL_EXIT:-0}" = 0 ] || exit "$UPDATE_ALL_TEST_BREW_INSTALL_EXIT"
                touch "$UPDATE_ALL_TEST_DIR/unlinked-updated"
                exit 0
                ;;
            upgrade)
                if [ "${UPDATE_ALL_TEST_BREW_UNLINKED:-0}" = 1 ] && [ ! -f "$UPDATE_ALL_TEST_DIR/unlinked-updated" ]; then
                    echo 'Error: Could not symlink bin/tsc; npm target already exists' >&2
                    exit 1
                fi
                ;;
        esac
        if [ "$1" = cleanup ]; then
            echo 'cleanup output'
            exit "${UPDATE_ALL_TEST_CLEANUP_EXIT:-0}"
        fi
        echo 'Homebrew output'
        exit "${UPDATE_ALL_TEST_BREW_EXIT:-0}"
        ;;
    mise)
        echo 'mise output'
        exit "${UPDATE_ALL_TEST_MISE_EXIT:-0}"
        ;;
    nvim)
        exec /bin/sleep 30
        ;;
    pipx)
        echo call >> "$UPDATE_ALL_TEST_DIR/pipx.calls"
        printf '%s\n' "$UPDATE_ALL_INTERACTIVE" > "$UPDATE_ALL_TEST_DIR/pipx.interactive"
        if [ "${UPDATE_ALL_INTERACTIVE:-0}" = 1 ]; then
            [ -t 0 ] || exit 12
        else
            cat > "$UPDATE_ALL_TEST_DIR/pipx.stdin" || exit 13
            [ ! -s "$UPDATE_ALL_TEST_DIR/pipx.stdin" ] || exit 14
        fi
        echo 'pipx output'
        exit 0
        ;;
    codex)
        echo call >> "$UPDATE_ALL_TEST_DIR/codex.calls"
        printf '%s\n' "$@" > "$UPDATE_ALL_TEST_DIR/codex.args"
        printf '%s\n' "$UPDATE_ALL_CODEX_ACTIVE" > "$UPDATE_ALL_TEST_DIR/codex.guard"
        echo 'Codex test result'
        exit "${UPDATE_ALL_TEST_CODEX_EXIT:-0}"
        ;;
esac
exit 127
